# Public providers are suitable only for low-volume demos. Use compliant/self-hosted
# equivalents for production; no private map API keys are needed by this prototype.
YUVADRIVE_DEMO_MODE=false
YUVADRIVE_GEOCODING_URL=https://nominatim.openstreetmap.org
YUVADRIVE_ROUTING_URL=https://router.project-osrm.org
YUVADRIVE_FUEL_L_PER_100KM=7.2
YUVADRIVE_CO2_GRAMS_PER_KM=145
YUVADRIVE_OFF_ROUTE_THRESHOLD_METERS=65
YUVADRIVE_SEARCH_DEBOUNCE_MS=350
YUVADRIVE_ROUTE_COOLDOWN_MS=30000
