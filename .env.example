# Leave empty to run the fully labelled local Demo Mode.
GOOGLE_MAPS_API_KEY=
# Set true to force demo data even when a key exists.
YUVADRIVE_DEMO_MODE=false
# CarbonStride estimates: configurable YuvaDrive assumptions, not Google data.
YUVADRIVE_FUEL_L_PER_100KM=7.2
YUVADRIVE_CO2_GRAMS_PER_KM=145
YUVADRIVE_OFF_ROUTE_THRESHOLD_METERS=50
